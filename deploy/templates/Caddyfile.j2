{% for domain in alternate_domains -%}
{{ domain }} {
	redir https://{{ site_domain }}{uri} permanent
}

{% endfor -%}
{{ site_domain }} {
	encode zstd gzip

	# Caddy owns the response security headers for both the static frontend and
	# the proxied API. The application listens on loopback only, so nothing
	# reaches it without passing through here, and the policy that governs a
	# document belongs with whatever serves the document.
	header {
		Content-Security-Policy "{{ content_security_policy }}"
		Referrer-Policy "no-referrer"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Permissions-Policy "camera=(), geolocation=(), microphone=()"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}

	@maintenance file {
		root {{ maintenance_dir }}
		try_files enabled
	}

	# Deploys take the whole site down, not just the API: the frontend can do
	# nothing useful while the API is migrating, and one unambiguous 503 page
	# reads better than the SPA's generic error screen.
	handle @maintenance {
		root * {{ maintenance_dir }}
		rewrite * /maintenance.html
		header Retry-After "300"
		file_server {
			status 503
		}
	}

	# Everything the application still owns. `handle` takes a single matcher
	# token, so the three prefixes are named together.
	@application path /api/* /auth/* /health/*

	handle @application {
		reverse_proxy 127.0.0.1:8000
	}

	# Content-addressed bundles, safe to cache forever. Deliberately no SPA
	# fallback under /_app: a request for a chunk a superseded release owned must
	# answer 404, not index.html with status 200, which the browser would try to
	# parse as JavaScript.
	handle /_app/immutable/* {
		root * {{ frontend_dir }}/current
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# The rest of /_app, notably version.json, which SvelteKit polls to notice a
	# new release and so must never serve stale.
	handle /_app/* {
		root * {{ frontend_dir }}/current
		header Cache-Control "no-cache"
		file_server
	}

	handle {
		root * {{ frontend_dir }}/current
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
