database:
  url: "postgresql:///lfsplanet?user=lfsplanet"

web:
  session_key: {{ session_key | tojson }}
  listen: "127.0.0.1:8000"
  public_base_url: {{ ("https://" ~ site_domain) | tojson }}
  cookie_secure: true
  #site_notice: "Hold on tight. Uploads are currently paused in preparation for LFS World migration."

storage:
  object_store_root: {{ object_store_root | tojson }}

hotlaps:
  allow_test_validation: false
  max_spr_upload_bytes: {{ max_spr_upload_bytes | tojson }}
  allow_uploads: true

worker:
  hlvc:
    poll_interval_seconds: 2
    timeout_seconds: 300
  webhooks:
    workers: {{ webhook_workers | tojson }}

lfs:
  installation_root: {{ (state_dir ~ "/games") | tojson }}
  wine_prefix: {{ (state_dir ~ "/wine") | tojson }}
  wine_executable: "/usr/bin/wine"
  bubblewrap_executable: "/usr/bin/bwrap"
{% if oauth_client_id %}
  oauth:
    client_id: {{ oauth_client_id | tojson }}
    client_secret: {{ oauth_client_secret | tojson }}
{% endif %}
