# Managed by lfsplanet pgBackRest setup. Contains secrets: root:postgres, 0640.
[global]
repo1-type=s3
repo1-path=/lfsplanet
repo1-s3-bucket={{ backup.bucket }}
repo1-s3-endpoint={{ backup.endpoint }}
repo1-storage-port={{ backup.port }}
repo1-s3-region={{ backup.region }}
repo1-s3-uri-style=path
repo1-s3-key={{ backup.access_key }}
repo1-s3-key-secret={{ backup.secret_key }}
repo1-cipher-type=aes-256-cbc
repo1-cipher-pass={{ backup.cipher_pass }}
repo1-retention-full-type=time
repo1-retention-full={{ backup.retention_days }}
start-fast=y
process-max=2
log-level-console=info
log-level-file=off
lock-path=/var/lib/pgbackrest

[lfsplanet]
pg1-path=/var/lib/postgresql/18/main
pg1-socket-path=/var/run/postgresql
pg1-port=5432
