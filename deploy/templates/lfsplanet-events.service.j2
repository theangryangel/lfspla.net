[Unit]
Description=Synchronize public LFS event advertisements
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
TimeoutStartSec=40min
User={{ host.data.app_user }}
Group={{ host.data.app_group }}
WorkingDirectory={{ host.data.state_dir }}
Environment=RUST_LOG=warn,lfsplanet=info
EnvironmentFile={{ host.data.config_dir }}/storage.env
ExecStart={{ host.data.app_root }}/lfsplanet --config {{ host.data.config_dir }}/config.yaml maintenance sync-events
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths={{ host.data.config_dir }}
ReadWritePaths={{ host.data.state_dir }}
